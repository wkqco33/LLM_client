# example_chat(examples/main.cpp)이 런타임에 직접 읽어 사용하는 값입니다.
# 이 파일을 .env로 복사한 뒤 실제 값으로 채워 넣으면 `./manage.sh run` 실행 시
# 자동으로 로드됩니다 (컴파일 타임에 바이너리로 굽히지 않으므로 안전합니다).
# 둘 다 비워두면 기본값(http://localhost:11434, llama3)을 사용합니다.
# Ollama는 API 키가 필요 없습니다.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# 아래 값들은 example_chat이 직접 사용하진 않지만, LLMClientFactory로 다른
# 프로바이더를 직접 연동하는 코드를 작성할 때 흔히 쓰는 환경 변수명입니다.
# 필요한 프로바이더의 키만 채워서 llm_client::Config::getEnv()로 읽으세요.
# OPENAI_API_KEY="your_openai_api_key_here"
# AZURE_OPENAI_API_KEY="your_azure_openai_api_key_here"
# AZURE_OPENAI_BASE_URL="https://your-resource-name.openai.azure.com/"
